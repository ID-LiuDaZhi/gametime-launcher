<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="ListGameItemTemplate" TargetType="{x:Type GameListItem}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type GameListItem}">
  <Border Background="#F4E8D0" BorderBrush="#D5BE95" BorderThickness="3,3,3,8" CornerRadius="20" Padding="9"><Border.Effect><DropShadowEffect Color="#755A35" BlurRadius="20" ShadowDepth="9" Opacity="0.32"/></Border.Effect><Grid><Image x:Name="PART_ImageCover" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/><Border Background="#F5F0E2" VerticalAlignment="Bottom" Padding="8,12" CornerRadius="0,0,10,10"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Foreground="#303A29" FontSize="26" FontWeight="Bold" FontFamily="Microsoft YaHei UI"/></Border></Grid></Border>
 </ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
